# LOKAL cloud PostgreSQL mode. Keep this file out of source control after
# replacing the sample credentials.
LOKAL_DB_PROVIDER=postgres
LOKAL_DB_DSN=postgres://lokal_app:replace-me@db.example.com:5432/lokal?sslmode=verify-full

# Safe initial pool values for one LOKAL application-server instance.
LOKAL_DB_CONNECT_TIMEOUT=10s
LOKAL_DB_MAX_OPEN_CONNS=20
LOKAL_DB_MAX_IDLE_CONNS=5
LOKAL_DB_CONN_MAX_LIFETIME=30m

# Accept durable outbox batches from registered local LOKAL installations.
# Use the same long random value on the sending local server.
LOKAL_SYNC_SECRET=replace-with-a-long-random-shared-secret

# Accept persistent edge connections from classroom PCs. Use the same relay
# secret on every explicitly authorized local installation.
LOKAL_RELAY_HOST_ENABLED=true
LOKAL_RELAY_SECRET=replace-with-a-different-long-random-shared-secret
