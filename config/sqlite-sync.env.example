# LOKAL offline-first local database with optional cloud synchronization.
LOKAL_DB_PROVIDER=sqlite

# Hosted LOKAL application URL (not a direct PostgreSQL URL).
LOKAL_CLOUD_SYNC_URL=https://class.example.edu
LOKAL_SYNC_SECRET=replace-with-a-long-random-shared-secret
LOKAL_SYNC_INTERVAL=5s

# Real-time hybrid classroom transport. This may be the hosted LOKAL base URL
# or its complete wss://.../api/v1/relay/edge endpoint.
LOKAL_RELAY_URL=https://class.example.edu
LOKAL_RELAY_SECRET=replace-with-a-different-long-random-shared-secret
# Optional override. When omitted, SQLite's durable sync_node identity is used.
# LOKAL_RELAY_NODE_ID=school-lab-room-101
